{
  "name": "movielens_content_strategy",
  "compatibilityLevel": 1600,
  "model": {
    "culture": "en-US",
    "dataAccessOptions": {
      "legacyRedirects": true,
      "returnErrorValuesAsNull": true
    },
    "defaultPowerBIDataSourceVersion": "powerBI_V3",
    "sourceQueryCulture": "en-US",
    "tables": [
      {
        "name": "_Measures",
        "lineageTag": "aa0f6aca-bee8-51eb-a92b-2703bbd6985c",
        "columns": [
          {
            "name": "_",
            "dataType": "int64",
            "lineageTag": "17c3920d-55fb-56da-a4fa-95a633b31313",
            "type": "calculatedTableColumn",
            "isNameInferred": true,
            "isDataTypeInferred": true,
            "sourceColumn": "[_]",
            "formatString": "#,0",
            "summarizeBy": "sum",
            "isHidden": true
          }
        ],
        "partitions": [
          {
            "name": "_Measures",
            "mode": "import",
            "source": {
              "type": "calculated",
              "expression": "ROW ( \"_\", 0 )"
            }
          }
        ],
        "measures": [
          {
            "name": "Total Ratings",
            "expression": "MAX ( dashboard_kpis[total_ratings] )",
            "formatString": "#,0",
            "lineageTag": "fe396a9e-a16f-5d4c-9644-28d4a5cdacae"
          },
          {
            "name": "Total Users",
            "expression": "MAX ( dashboard_kpis[total_users] )",
            "formatString": "#,0",
            "lineageTag": "0ce70ca9-d872-575c-9a6d-1e6c1455a759"
          },
          {
            "name": "Total Movies",
            "expression": "MAX ( dashboard_kpis[total_movies] )",
            "formatString": "#,0",
            "lineageTag": "0837fa07-4b21-5e8b-8bcf-ef6ab70d2102"
          },
          {
            "name": "Total Tags",
            "expression": "MAX ( dashboard_kpis[total_tags] )",
            "formatString": "#,0",
            "lineageTag": "a8059ca8-db22-5b3f-a1bd-c15ac40da98c"
          },
          {
            "name": "Average Rating",
            "expression": "MAX ( dashboard_kpis[average_rating] )",
            "formatString": "0.000",
            "lineageTag": "ab5a6fd7-42f2-596f-b522-a7119e50ef47"
          },
          {
            "name": "Positive Rating Rate",
            "expression": "MAX ( dashboard_kpis[positive_rating_rate] )",
            "formatString": "0.0%",
            "lineageTag": "3d09aae7-2516-5d50-9716-d4c2c6a10d1a"
          },
          {
            "name": "Test Support",
            "expression": "SUM ( dashboard_content_opportunities[test_support] )",
            "formatString": "#,0",
            "lineageTag": "c45f2f2b-6979-57fc-af72-be253d02c493"
          },
          {
            "name": "Predicted Like Probability",
            "expression": "DIVIDE (\n    SUMX ( dashboard_content_opportunities,\n        dashboard_content_opportunities[predicted_like_probability] * dashboard_content_opportunities[test_support] ),\n    [Test Support]\n)",
            "formatString": "0.0%",
            "lineageTag": "21155e05-f5eb-5436-a568-d5c6a3ddf257"
          },
          {
            "name": "Actual Positive Rate",
            "expression": "DIVIDE (\n    SUMX ( dashboard_content_opportunities,\n        dashboard_content_opportunities[actual_positive_rate] * dashboard_content_opportunities[test_support] ),\n    [Test Support]\n)",
            "formatString": "0.0%",
            "lineageTag": "273b0d89-81fc-5068-b926-0e7c8510c978"
          },
          {
            "name": "Calibration Gap",
            "expression": "[Predicted Like Probability] - [Actual Positive Rate]",
            "formatString": "+0.0%;-0.0%;0.0%",
            "lineageTag": "b89ee033-dcd1-5faf-9685-9bf89f5f1456"
          },
          {
            "name": "Train Popularity",
            "expression": "MAX ( dashboard_content_opportunities[train_popularity] )",
            "formatString": "#,0",
            "lineageTag": "ae2b7340-c083-5071-9d9c-c3c8c7a603ba"
          },
          {
            "name": "Min Support Value",
            "expression": "SELECTEDVALUE ( 'Min Support'[Min Support], 50 )",
            "formatString": "#,0",
            "lineageTag": "573778b8-111c-55a6-8599-62f27e7b06b5"
          },
          {
            "name": "Passes Min Support",
            "expression": "IF ( [Test Support] >= [Min Support Value], 1, 0 )",
            "formatString": "0",
            "lineageTag": "cb2ca1a6-5cbc-5048-899a-9f6cce4cf908"
          },
          {
            "name": "Predicted Like (Supported)",
            "expression": "IF ( [Test Support] >= [Min Support Value], [Predicted Like Probability] )",
            "formatString": "0.0%",
            "lineageTag": "d9b8a5d5-2d44-5be1-a0d7-06daed161f87"
          },
          {
            "name": "Test Support (Supported)",
            "expression": "IF ( [Test Support] >= [Min Support Value], [Test Support] )",
            "formatString": "#,0",
            "lineageTag": "0181e3f0-92c3-5c30-b60b-3fede825df43"
          },
          {
            "name": "Train Popularity (Supported)",
            "expression": "IF ( [Test Support] >= [Min Support Value], [Train Popularity] )",
            "formatString": "#,0",
            "lineageTag": "cc44bc38-63b0-5cf5-a771-43c9f6a9ddcb"
          },
          {
            "name": "Supported Movies",
            "expression": "COUNTROWS (\n    FILTER ( VALUES ( dashboard_content_opportunities[movie_id] ), [Test Support] >= [Min Support Value] )\n)",
            "formatString": "#,0",
            "lineageTag": "da1c1dfe-7636-5735-aaf5-9b19d960f6d4"
          },
          {
            "name": "Test Metric",
            "expression": "CALCULATE (\n    MAX ( dashboard_model_metrics[metric_value] ),\n    dashboard_model_metrics[split_name] = \"TEST\",\n    dashboard_model_metrics[model_name] = \"logistic_regression\"\n)",
            "formatString": "0.0%",
            "lineageTag": "0f29b1c8-eaea-5d13-b877-a26443c663ea"
          },
          {
            "name": "Test Accuracy",
            "expression": "CALCULATE ( [Test Metric], dashboard_model_metrics[metric_name] = \"accuracy\" )",
            "formatString": "0.0%",
            "lineageTag": "b84fc8fa-d5d7-5636-9328-7a275edafdf7"
          },
          {
            "name": "Test Precision",
            "expression": "CALCULATE ( [Test Metric], dashboard_model_metrics[metric_name] = \"precision\" )",
            "formatString": "0.0%",
            "lineageTag": "cce3c149-4f91-521a-ad2d-206f1e517cd8"
          },
          {
            "name": "Test Recall",
            "expression": "CALCULATE ( [Test Metric], dashboard_model_metrics[metric_name] = \"recall\" )",
            "formatString": "0.0%",
            "lineageTag": "a078a417-0882-5573-b107-727c7c1f22e9"
          },
          {
            "name": "Test F1",
            "expression": "CALCULATE ( [Test Metric], dashboard_model_metrics[metric_name] = \"f1\" )",
            "formatString": "0.0%",
            "lineageTag": "d4bf1cf9-8935-524f-b4ce-7157393e7ed5"
          },
          {
            "name": "Test AUC",
            "expression": "CALCULATE ( [Test Metric], dashboard_model_metrics[metric_name] = \"auc\" )",
            "formatString": "0.000",
            "lineageTag": "1a663c3c-0bff-5a76-a127-a7c93939514a"
          },
          {
            "name": "Baseline Accuracy",
            "expression": "CALCULATE ( [Test Metric], dashboard_model_metrics[metric_name] = \"baseline_accuracy\" )",
            "formatString": "0.0%",
            "lineageTag": "74581b2e-e32d-5722-a135-6eee79783872"
          },
          {
            "name": "Lift vs Baseline",
            "expression": "[Test Accuracy] - [Baseline Accuracy]",
            "formatString": "+0.0%;-0.0%;0.0%",
            "lineageTag": "5a2c37d4-d3db-5c54-b7a5-a1005f961ab3"
          },
          {
            "name": "TEST Rows",
            "expression": "CALCULATE ( [Test Metric], dashboard_model_metrics[metric_name] = \"test_rows\" )",
            "formatString": "#,0",
            "lineageTag": "f099e97b-e29a-5255-8296-b75e10c30399"
          },
          {
            "name": "Prediction Rows (TEST)",
            "expression": "CALCULATE (\n    SUM ( dashboard_confusion_matrix[row_count] ),\n    dashboard_confusion_matrix[data_split] = \"TEST\"\n)",
            "formatString": "#,0",
            "lineageTag": "ddd0c001-9a09-58ae-b336-a4b9ef7bf11a"
          },
          {
            "name": "Coefficient",
            "expression": "IF (\n    LEFT ( SELECTEDVALUE ( dashboard_model_metrics[metric_name] ), 5 ) = \"coef_\",\n    CALCULATE (\n        MAX ( dashboard_model_metrics[metric_value] ),\n        dashboard_model_metrics[split_name] = \"TRAIN\",\n        dashboard_model_metrics[model_name] = \"logistic_regression\"\n    )\n)",
            "formatString": "0.000",
            "lineageTag": "cdde2b59-8ec7-5a48-af38-8b961653ce04"
          },
          {
            "name": "Silhouette",
            "expression": "IF (\n    LEFT ( SELECTEDVALUE ( dashboard_model_metrics[metric_name] ), 12 ) = \"silhouette_k\",\n    CALCULATE ( MAX ( dashboard_model_metrics[metric_value] ), dashboard_model_metrics[model_name] = \"kmeans\" )\n)",
            "formatString": "0.000",
            "lineageTag": "59f0b4e5-9ce6-54ee-bea0-6c1f31671551"
          }
        ]
      },
