            "type": "calculatedTableColumn",
            "isNameInferred": true,
            "isDataTypeInferred": true,
            "sourceColumn": "[model_version]",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "Model Versions",
            "mode": "import",
            "source": {
              "type": "calculated",
              "expression": "DISTINCT (\n    UNION (\n        SELECTCOLUMNS ( dashboard_content_opportunities, \"model_version\", dashboard_content_opportunities[model_version] ),\n        SELECTCOLUMNS ( dashboard_confusion_matrix, \"model_version\", dashboard_confusion_matrix[model_version] ),\n        SELECTCOLUMNS ( dashboard_model_metrics, \"model_version\", dashboard_model_metrics[model_version] )\n    )\n)"
            }
          }
        ]
